{
  "manifest_version": 1,
  "type": "device",
  "name": "TP-Link Kasa",
  "description": {
    "en": "Control your TP-Link Kasa smart plugs, switches and bulbs over your local network.",
    "fr": "Contrôlez vos prises, interrupteurs et ampoules TP-Link Kasa sur votre réseau local."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/cicoub13/gladys-tp-link:1.0.1",
  "gladys_version": ">=4.62.0",
  "cover_image": "https://raw.githubusercontent.com/cicoub13/gladys-tp-link/main/cover.png",
  "transports": [
    "local"
  ],
  "config_schema": [
    {
      "key": "device_ips",
      "type": "string",
      "label": {
        "en": "Device IP addresses",
        "fr": "Adresses IP des appareils"
      },
      "description": {
        "en": "Comma or space separated list of TP-Link device IP addresses. Recommended: the integration runs in an isolated container that reaches devices by IP, but usually cannot receive LAN broadcast discovery.",
        "fr": "Liste d'adresses IP d'appareils TP-Link, séparées par des virgules ou des espaces. Recommandé : l'intégration s'exécute dans un conteneur isolé qui joint les appareils par IP, mais ne reçoit généralement pas la découverte par diffusion réseau."
      },
      "placeholder": {
        "en": "192.168.1.20, 192.168.1.21",
        "fr": "192.168.1.20, 192.168.1.21"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement"
      },
      "description": {
        "en": "How often each device is polled to refresh its state.",
        "fr": "Fréquence d'interrogation de chaque appareil pour rafraîchir son état."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Every second",
            "fr": "Toutes les secondes"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Every 2 seconds",
            "fr": "Toutes les 2 secondes"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "Every 10 seconds",
            "fr": "Toutes les 10 secondes"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 seconds",
            "fr": "Toutes les 15 secondes"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 seconds",
            "fr": "Toutes les 30 secondes"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every minute",
            "fr": "Toutes les minutes"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_device",
      "label": {
        "en": "Test a device by IP",
        "fr": "Tester un appareil par IP"
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "ip",
          "type": "string",
          "label": {
            "en": "IP address",
            "fr": "Adresse IP"
          },
          "placeholder": {
            "en": "192.168.1.20",
            "fr": "192.168.1.20"
          },
          "required": true
        }
      ]
    }
  ]
}
